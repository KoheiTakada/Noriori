<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:navigationBarColor">@color/ds_surface</item>
        <item name="android:statusBarColor">@color/ds_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/ds_canvas</item>
        <item name="android:colorControlNormal">@color/ds_muted</item>
        <item name="android:colorControlActivated">@color/ds_primary</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
